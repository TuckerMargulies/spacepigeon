# Server-side only. Set these in Vercel (Project → Settings → Environment Variables).
# For local work: copy to .env.local (gitignored) and run `npm run dev`.

# Supabase — set by the Vercel ↔ Supabase integration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key (order confirmations and admin sign-in links)
resend_key=

# 32+ random characters; signs admin sign-in links and sessions. Changing it signs everyone out.
SESSION_SECRET=

# Optional (defaults shown)
ADMIN_EMAILS=admin@coalesce.nyc
ORDER_CC=admin@coalesce.nyc
EMAIL_FROM=Space Pigeon <orders@spacepigeon.net>
SITE_URL=https://spacepigeon.net
